    {
      "parameters": {
        "fromEmail": "REDACTED_EMAIL",
        "toEmail": "REDACTED_EMAIL",
        "subject": "\ud83d\udcc8 Global Market Alert \u2014 Top Picks Today",
        "html": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Global Market Alert</title>\n  <style>\n    body { margin:0; padding:0; background-color:#f5f5f5; font-family:'Helvetica Neue',Helvetica,Arial,sans-serif; }\n    @media only screen and (max-width:600px) {\n      .outer-table { padding:16px 0 !important; }\n      .inner-table { width:100% !important; border-radius:0 !important; }\n      .header-td { padding:24px 20px 20px !important; }\n      .content-td { padding:20px 16px 8px !important; }\n      .pick-div { padding:12px 14px !important; }\n      .footer-td { padding:14px 20px !important; }\n      .disclaimer-td { padding:14px 20px 20px !important; }\n    }\n  </style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#f5f5f5;font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;\">\n  <table class=\"outer-table\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#f5f5f5;padding:32px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table class=\"inner-table\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e0e0e0;\">\n\n          <!-- HEADER -->\n          <tr>\n            <td class=\"header-td\" style=\"background-color:#000000;padding:28px 32px 24px;border-bottom:3px solid #000000;\">\n              <h1 style=\"margin:0 0 4px;font-size:20px;font-weight:700;color:#ffffff;letter-spacing:-0.3px;\">\ud83d\udcca Today's Picks</h1>\n              <p style=\"margin:0 0 8px;font-size:11px;color:rgba(255,255,255,0.6);letter-spacing:2px;text-transform:uppercase;\">Daily Market Intelligence Report</p>\n              <p style=\"margin:0;font-size:12px;color:rgba(255,255,255,0.5);border:1px solid rgba(255,255,255,0.2);display:inline-block;padding:3px 12px;border-radius:20px;\">{{  $now.format('cccc, MMMM d, yyyy') }}</p>\n            </td>\n          </tr>\n\n          <!-- PICKS LIST -->\n          <tr>\n            <td class=\"content-td\" style=\"padding:24px 28px 8px;\">\n              <p style=\"margin:0 0 16px;font-size:11px;font-weight:700;color:#000000;letter-spacing:2px;text-transform:uppercase;border-bottom:2px solid #000000;padding-bottom:8px;\">\ud83c\udfc6 Top 10 Picks</p>\n{{  $json.content.split('\\n').filter(l => /^\\d+\\./.test(l.trim()) || (function(){return false})()).reduce((acc, line, i, arr) => { const raw = $json.content; const blocks = raw.split(/(?=\\n\\d+\\.\\s)/); return blocks;}, []).length > 0 ? (function(){ const raw = $json.content || ''; const lines = raw.split('\\n'); const picks = []; let current = null; for (const line of lines) { const match = line.match(/^(\\d+)\\.\\s+(.+)/); if (match) { if (current) picks.push(current); current = { num: match[1], title: match[2], why: '', risk: '', action: '' }; } else if (current) { if (line.startsWith('Why:')) current.why = line.replace('Why:', '').trim(); else if (line.startsWith('Risk:')) { const rp = line.match(/Risk:\\s*([^|]+)\\|?\\s*Action:\\s*(.+)/i); if (rp) { current.risk = rp[1].trim(); current.action = rp[2].trim(); } else current.risk = line.replace('Risk:', '').trim();\n              } } } if (current) picks.push(current);\n              const actionColors = { 'Buy': '#000000', 'Watch': '#555555', 'Sell': '#888888', 'Avoid': '#888888' };\n              const riskColors = { 'Low': '#000000', 'Medium': '#555555', 'High': '#888888', 'Speculative': '#aaaaaa' };\n              return picks.map((p, i) => {\n                const ac = actionColors[p.action] || '#000000';\n                const rc = riskColors[p.risk] || '#555555';\n                const bg = i % 2 === 0 ? '#ffffff' : '#fafafa';\n                return `<div class=\"pick-div\" style=\"background:${bg};border-radius:4px;padding:14px 16px;margin-bottom:8px;border-left:3px solid ${ac};border:1px solid #e8e8e8;border-left:3px solid ${ac};\">\n                  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                    <tr>\n                      <td style=\"vertical-align:top;width:28px;\">\n                        <span style=\"display:inline-block;background:#000000;color:#ffffff;font-size:10px;font-weight:700;width:22px;height:22px;line-height:22px;text-align:center;border-radius:50%;\">${p.num}</span>\n                      </td>\n                      <td style=\"vertical-align:top;padding-left:10px;\">\n                        <p style=\"margin:0 0 4px;font-size:14px;font-weight:700;color:#000000;\">${p.title}</p>\n                        <p style=\"margin:0 0 8px;font-size:12px;color:#555555;line-height:1.5;\">${p.why}</p>\n                        <table cellpadding=\"0\" cellspacing=\"0\">\n                          <tr>\n                            <td style=\"padding-right:8px;\"><span style=\"background:#f0f0f0;color:${rc};font-size:11px;font-weight:600;padding:2px 10px;border-radius:12px;border:1px solid #cccccc;\">> ${p.risk} Risk</span></td>\n                            <td><span style=\"background:${ac};color:#ffffff;font-size:11px;font-weight:700;padding:2px 10px;border-radius:12px;border:1px solid ${ac}60;\">${p.action === 'Buy' ? '\u2713' : p.action === 'Watch' ? '\u25ce' : '\u2717'} ${p.action}</span></td>\n                          </tr>\n                        </table>\n                      </td>\n                    </tr>\n                  </table>\n                </div>`;\n              }).join('');\n            })() : '' }}\n            </td>\n          </tr>\n\n          <!-- DIVIDER -->\n          <tr>\n            <td style=\"padding:8px 28px 0;\">\n              <div style=\"height:1px;background:#e0e0e0;\"></div>\n            </td>\n          </tr>\n\n          <!-- DISCLAIMER -->\n          <tr>\n            <td class=\"disclaimer-td\" style=\"padding:16px 28px 20px;\">\n              <p style=\"margin:0;font-size:11px;line-height:1.6;color:#999999;text-align:center;\">\u26a0\ufe0f This report is generated by AI for informational purposes only and does not constitute financial advice. Always do your own research before making investment decisions.</p>\n            </td>\n          </tr>\n\n          <!-- FOOTER -->\n          <tr>\n            <td class=\"footer-td\" style=\"background-color:#000000;padding:14px 28px;border-top:1px solid #000000;\">\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                <tr>\n                  <td></td>\n                  <td align=\"right\"><p style=\"margin:0;font-size:11px;color:rgba(255,255,255,0.4);\">{{   $now.format('HH:mm') }} UTC</p></td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {
