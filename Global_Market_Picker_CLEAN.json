        "jsCode": "const raw = $input.item.json.content || \n            $input.item.json.message?.content || '';\nconst ts = new Date().toLocaleString('en-GB');\n\nconst msg = `\ud83d\udcc8 **Market Scan** | ${ts}\\n________________\\n\\n${raw.trim()}\\n\\n________________\\n_\u2139\ufe0f Info only \u2014 not financial advice_`;\n\nif (msg.length <= 1900) {\n  return [{json: {message: msg, part2: ''}}];\n}\n\nconst splitAt = msg.lastIndexOf('\\n', 1850);\nreturn [{json: {\n  message: msg.substring(0, splitAt > 0 ? splitAt : 1850),\n  part2: msg.substring(splitAt > 0 ? splitAt : 1850).trim()\n}}];"
